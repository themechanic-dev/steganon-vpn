<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Home Lab</vendor>
  <action id="org.homelab.steganon.manage">
    <description>Manage the VPN connection and firewall</description>
    <description xml:lang="el">Διαχείριση της σύνδεσης VPN και του τείχους</description>
    <message>Authentication is required to change network rules.</message>
    <message xml:lang="el">Απαιτούνται δικαιώματα για την αλλαγή των κανόνων δικτύου.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/steganon</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
